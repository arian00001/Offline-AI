{
  "version": "1.2.0",
  "sha256": "ea56f6d544e5a6dceafd964fe99a1f1b8081a11ad73bedfd88c257a5b8f680ce",
  "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"theme-color\" content=\"#f8fbf6\"><title>DEV STYLE · Local AI</title><style>\n:root{--lime:#b8ef55;--lime2:#d8f8a1;--ink:#1e2b20;--muted:#7a887b;--line:#e7eee3;--glass:rgba(255,255,255,.78);--shadow:0 16px 45px rgba(54,83,38,.08)}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% 0%,#effbdc 0,transparent 38%),linear-gradient(135deg,#fbfdf9,#f4f8f1);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;min-height:100dvh}.app{max-width:980px;margin:auto;min-height:100dvh;padding:18px;display:flex;flex-direction:column;gap:14px}.top{display:flex;align-items:center;justify-content:space-between;padding:12px 15px;border:1px solid #fff;background:var(--glass);backdrop-filter:blur(20px);border-radius:22px;box-shadow:var(--shadow)}.brand{display:flex;gap:11px;align-items:center}.orb{width:42px;height:42px;border-radius:50%;background:radial-gradient(circle at 35% 28%,white 0 7%,#e5ffba 9%,#b9ed66 32%,#8fc83e 56%,#efffd8 70%,#a7de57 82%);box-shadow:0 0 0 6px #c5f1872e,0 5px 20px #9ed34c55;position:relative}.orb:after{content:\"\";position:absolute;inset:7px;border:1px solid #fff9;border-radius:50%;transform:rotateX(62deg) rotateZ(-25deg)}.brand strong{display:block;letter-spacing:.12em;font-size:12px}.brand span{display:block;color:var(--muted);font-size:12px;margin-top:3px}.status{display:flex;align-items:center;gap:7px;border:1px solid var(--line);background:#fff9;padding:8px 11px;border-radius:999px;font-size:11px;color:var(--muted)}.dot{width:7px;height:7px;border-radius:50%;background:#b7c4b3}.dot.on{background:#81c72e;box-shadow:0 0 0 4px #b8ef5533}.panel{flex:1;min-height:55vh;border:1px solid #fff;background:var(--glass);backdrop-filter:blur(22px);border-radius:28px;box-shadow:var(--shadow);display:flex;flex-direction:column;overflow:hidden}.welcome{padding:34px 22px 18px;text-align:center}.welcome .orb{width:64px;height:64px;margin:0 auto 17px}.welcome h1{font-size:clamp(24px,5vw,36px);letter-spacing:-.045em;margin:0}.welcome p{color:var(--muted);font-size:14px;line-height:1.6;max-width:440px;margin:10px auto 0}.suggestions{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:18px auto 0;max-width:700px}.suggestion{border:1px solid var(--line);background:#ffffffb8;border-radius:16px;padding:13px;text-align:left;color:var(--ink);font:inherit;font-size:12px;cursor:pointer;transition:.18s}.suggestion:hover{border-color:#b7e879;transform:translateY(-2px)}.messages{padding:20px;display:flex;flex-direction:column;gap:14px;overflow:auto;flex:1;scroll-behavior:smooth}.msg{display:flex;gap:10px;max-width:88%;align-items:flex-start}.msg.user{align-self:flex-end;flex-direction:row-reverse}.avatar{width:28px;height:28px;flex:0 0 28px;border-radius:10px;background:#edf8dd;color:#507c22;display:grid;place-items:center;font-size:10px;font-weight:800}.user .avatar{background:#29372b;color:white}.bubble{padding:13px 15px;border:1px solid var(--line);background:#ffffffd9;border-radius:6px 18px 18px 18px;font-size:14px;line-height:1.65;white-space:pre-wrap;overflow-wrap:anywhere}.user .bubble{background:#e7f7cc;border-color:#d8efb8;border-radius:18px 6px 18px 18px}.composer-wrap{padding:12px 14px 14px;border-top:1px solid #e9f0e5;background:#ffffff7d}.composer{display:flex;align-items:flex-end;gap:9px;padding:8px;border:1px solid #dfe9d8;background:#fff;border-radius:20px;box-shadow:0 5px 20px #47622a0c}.composer textarea{resize:none;min-height:42px;max-height:150px;flex:1;border:0;outline:0;background:transparent;padding:11px 8px;font:inherit;font-size:14px;color:var(--ink)}.send{width:43px;height:43px;border:0;border-radius:14px;background:var(--lime);color:#26391b;font-weight:900;font-size:18px;cursor:pointer}.send:disabled{opacity:.5}.foot{display:flex;justify-content:space-between;gap:10px;align-items:center;color:#879387;font-size:10px;padding:0 5px}.textbtn{border:0;background:transparent;color:#6d8d4b;font:inherit;font-weight:700;cursor:pointer;padding:6px}.tools{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 2px 8px;font-size:11px;color:var(--muted)}.searchToggle{display:flex;align-items:center;gap:6px;color:#5c7c3d;font-weight:700}.searchToggle input{accent-color:#8fc83e;width:15px;height:15px}.toolNote{font-size:10px}.typing{display:flex;gap:4px;padding:8px}.typing i{width:6px;height:6px;background:#9acb60;border-radius:50%;animation:b 1s infinite alternate}.typing i:nth-child(2){animation-delay:.2s}.typing i:nth-child(3){animation-delay:.4s}@keyframes b{to{opacity:.25;transform:translateY(-4px)}}@media(max-width:560px){.app{padding:10px;gap:10px}.top{padding:11px;border-radius:19px}.panel{border-radius:22px}.welcome{padding:25px 13px 12px}.suggestions{grid-template-columns:1fr;max-width:100%}.suggestion{padding:11px}.messages{padding:13px}.msg{max-width:95%}.foot{font-size:9px}.status{padding:7px 9px}}\n</style></head><body><main class=\"app\"><header class=\"top\"><div class=\"brand\"><div class=\"orb\"></div><div><strong>DEV STYLE</strong><span>Local Intelligence</span></div></div><div class=\"status\"><i class=\"dot\" id=\"dot\"></i><span id=\"status\">Connecting…</span></div></header><section class=\"panel\"><div class=\"welcome\" id=\"welcome\"><div class=\"orb\"></div><h1>Your private AI space.</h1><p>Chat with your on-device model. Conversations stay in this browser on this phone.</p><div class=\"suggestions\"><button class=\"suggestion\">Explain a difficult topic simply</button><button class=\"suggestion\">Help me plan a productive day</button><button class=\"suggestion\">Write a Kotlin function</button></div></div><div class=\"messages\" id=\"messages\" aria-live=\"polite\"></div><div class=\"composer-wrap\"><div class=\"tools\"><label class=\"searchToggle\"><input id=\"webSearch\" type=\"checkbox\"><span>Search web (online)</span></label><span class=\"toolNote\">Off by default · local chat stays offline</span></div><div class=\"composer\"><textarea id=\"input\" rows=\"1\" placeholder=\"Banglish, Bangla or English…\"></textarea><button class=\"send\" id=\"send\" aria-label=\"Send\">↑</button></div><div class=\"foot\"><span id=\"hint\">Local API · 127.0.0.1:8080</span><button class=\"textbtn\" id=\"clear\">Clear chat</button></div></div></section></main><script>\n(()=>{'use strict';const $=id=>document.getElementById(id),KEY='devstyle.localchat.history.v1';let history=[];try{history=JSON.parse(localStorage.getItem(KEY)||'[]');if(!Array.isArray(history))history=[]}catch{history=[]}function save(){try{localStorage.setItem(KEY,JSON.stringify(history.slice(-100)))}catch{ $('hint').textContent='Storage is full; clear older conversations.'}}function add(role,text,saveIt=true){$('welcome').style.display='none';const row=document.createElement('div');row.className='msg '+(role==='user'?'user':'assistant');const avatar=document.createElement('div');avatar.className='avatar';avatar.textContent=role==='user'?'YOU':'AI';const bubble=document.createElement('div');bubble.className='bubble';bubble.textContent=text;row.append(avatar,bubble);$('messages').append(row);$('messages').scrollTop=$('messages').scrollHeight;if(saveIt){history.push({role,content:text});save()}}function render(){if(history.length){$('welcome').style.display='none';history.slice(-100).forEach(m=>add(m.role,m.content,false))}}async function health(){try{const r=await fetch('/health',{cache:'no-store'});const j=await r.json();$('dot').classList.toggle('on',!!j.model_loaded);$('status').textContent=j.model_loaded?'Model ready':'API online · no model';$('hint').textContent=j.model_loaded?'On-device inference · conversation saved locally':'Open DEV STYLE app → Models → download and load a model';}catch{$('status').textContent='API unavailable';$('hint').textContent='Open the DEV STYLE app and start the local server.'}}async function send(text){text=(text??$('input').value).trim();if(!text)return;$('input').value='';resize();add('user',text);const btn=$('send');btn.disabled=true;const row=document.createElement('div');row.className='msg assistant';row.id='typing';row.innerHTML='<div class=\"avatar\">AI</div><div class=\"bubble\"><div class=\"typing\"><i></i><i></i><i></i></div></div>';$('messages').append(row);$('messages').scrollTop=$('messages').scrollHeight;let answer='';try{const msgs=history.slice(-16).map(m=>({role:m.role,content:m.content}));const r=await fetch('/v1/chat/completions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:'local-assistant',messages:msgs,stream:true,web_search:$('webSearch').checked,max_tokens:192})});if(!r.ok){let data={};try{data=await r.json()}catch{}throw new Error(data?.error?.message||('HTTP '+r.status))}const reader=r.body.getReader();const decoder=new TextDecoder();let buffer='';let firstToken=true;while(true){const {value,done}=await reader.read();if(done)break;buffer+=decoder.decode(value,{stream:true});const parts=buffer.split('\n\n');buffer=parts.pop()||'';for(const part of parts){for(const line of part.split('\n')){if(!line.startsWith('data: '))continue;const raw=line.slice(6).trim();if(raw==='[DONE]')continue;try{const data=JSON.parse(raw);const token=data?.choices?.[0]?.delta?.content;if(token){answer+=token;if(firstToken){row.querySelector('.bubble').textContent='';firstToken=false}$('typing').querySelector('.bubble').textContent=answer;$('messages').scrollTop=$('messages').scrollHeight}}catch{}}}}if(!answer.trim())throw new Error('The model returned an empty response.');row.remove();add('assistant',answer)}catch(e){row.remove();add('assistant','Response problem: '+(e.message||'Unknown error')+'. Check that a model is loaded. Web search needs internet; switch it off to chat offline.')}finally{btn.disabled=false;$('input').focus();health()}}function resize(){const el=$('input');el.style.height='auto';el.style.height=Math.min(el.scrollHeight,150)+'px'}$('send').addEventListener('click',()=>send());$('webSearch').addEventListener('change',()=>{$('hint').textContent=$('webSearch').checked?'Web search enabled · needs internet':'Local inference · can work offline'});$('input').addEventListener('input',resize);$('input').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send()}});$('clear').addEventListener('click',()=>{if(!confirm('Clear saved conversation from this browser?'))return;history=[];save();$('messages').replaceChildren();$('welcome').style.display='block'});document.querySelectorAll('.suggestion').forEach(b=>b.addEventListener('click',()=>send(b.textContent)));render();health();setInterval(health,8000)})();\n</script></body></html>"
}